# Hobbyist AI - Environment Variables
FLASK_APP=hobbyist
FLASK_ENV=development

# Strands Agents
STRANDS_AGENTS_ENABLED=true

# Eventbrite
EVENTBRITE_API_KEY=your_eventbrite_api_key
EVENTBRITE_CLIENT_ID=your_eventbrite_client_id
EVENTBRITE_ACCESS_TOKEN=your_eventbrite_access_token

# Meetup
MEETUP_API_KEY=your_meetup_api_key

# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback

# JWT
SECRET_KEY=your-secret-key-change-in-production-256-bit-minimum

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Debug
DEBUG=true