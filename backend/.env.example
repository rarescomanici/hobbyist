"""
Hobbyist AI App - Python Backend
An AI-powered hobby recommendation app using Strands Agents framework
"""

from pydantic_settings import BaseSettings
from pydantic import BaseModel
from typing import Optional, List

# Settings configuration
class Settings(BaseSettings):
    APP_NAME: str = "Hobbyist AI"
    VERSION: str = "0.1.0"
    DEBUG: bool = True
    
    # Strands Agents configuration
    STRANDS_AGENTS_ENABLED: bool = True
    
    # API Configuration
    MEETUP_API_KEY: Optional[str] = None
    EVENTBRITE_API_KEY: Optional[str] = None
    
    class Config:
        env_file = ".env"

settings = Settings()